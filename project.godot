; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Панк-Рок Кликер: ХОЙ!"
config/description="Боевой кликер в мире панк-сказки. Бей нечисть, собирай труппу, кричи ХОЙ!"
run/main_scene="res://game/scenes/Main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/bg_color=Color(0.101961, 0.07451, 0.12549, 1)
boot_splash/show_image=false
config/icon="res://icon/icon_512.png"

[audio]

driver/enable_input=true

[autoload]

Balance="*res://game/config/Balance.gd"
Economy="*res://game/autoload/Economy.gd"
Monetization="*res://game/autoload/Monetization.gd"
Game="*res://game/autoload/Game.gd"
Notify="*res://game/autoload/Notify.gd"
Analytics="*res://game/autoload/Analytics.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=720
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotAndroidYandexAds/plugin.cfg")

[input]

Screenshot={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":80,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gravity=true
sensors/enable_gyroscope=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.101961, 0.07451, 0.12549, 1)
