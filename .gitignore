# --- Godot 4 ---
.godot/

# --- Сборки / вывод (большое, регенерируется) ---
/build/
shot.png
*.tmp

# --- Временные логи прогона/рендера ---
*.log
*.err
store_shots_log.txt

# --- Тяжёлые стор-ролики (локально / вне git) ---
store/trailer/*.mp4

# --- Android Gradle build template: исходник коммитим, тяжёлое/кэш — нет ---
# (libs/ содержит движковую .aar >100 МБ — GitHub её не примет; восстанавливается
#  через Project → Install Android Build Template)
android/build/build/
android/build/libs/
android/build/.gradle/
android/build/.cxx/
android/build/assetPackInstallTime/
android/build/src/main/assets/
shot.png.import

# --- Исходники-оригиналы арта (генерятся отдельно; в репо не нужны) ---
art_in/

# --- OS ---
Thumbs.db
.DS_Store
desktop.ini

# --- Секреты подписи (release keystore creds) ---
export_presets.credentials.cfg

# --- Секреты аналитики ---
.env

# --- Входящие выгрузки для среза (локально) ---
store/health_inbox/*
.mcp/

# --- Cursor / MCP runtime (не в репо) ---
.cursor/
mcp_bridge.gd
_am_*.json

# --- Арт-кандидаты и бэкапы (в APK не едут; пайплайн локально) ---
art/enemies/v2/
art/enemies/_pre_v2_bak/
art/bg/v2/
art/keyart/
**/*.prev_gen.bak
**/*.zss_grimdark.bak
**/*.chest.bak
